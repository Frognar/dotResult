root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,props,targets,csproj,slnx,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:warning

# Language
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Naming: PascalCase for public members, with deliberate exceptions (Prelude.ok and Prelude.error).
dotnet_naming_rule.public_members_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_pascal_case.style = pascal_case
dotnet_naming_rule.public_members_pascal_case.severity = suggestion
dotnet_naming_symbols.public_members.applicable_kinds = property, method, field, event, class, struct, interface, enum, delegate
dotnet_naming_symbols.public_members.applicable_accessibilities = public
dotnet_naming_style.pascal_case.capitalization = pascal_case

# Tests use sentence-like method names with underscores.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# The library builds with AnalysisLevel latest-all (src/DotResult/DotResult.csproj). Deliberate exceptions:
[src/**/*.cs]
# C# unions need the nested member-provider interface Result<T, TError>.IUnionMembers, with static Create and TryGetValue.
dotnet_diagnostic.CA1034.severity = none
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1021.severity = none
# Exception messages are not localized.
dotnet_diagnostic.CA1303.severity = none
# Error<TError> is the natural name of the error case; "Error" is a Visual Basic keyword, but VB callers can escape it ([Error]).
dotnet_diagnostic.CA1716.severity = none

# R8: the async helpers catch every exception from a delegate and hand it back through the ValueTask.
[src/DotResult/Result.Async.cs]
dotnet_diagnostic.CA1031.severity = none

# R13: Try/TryAsync turn every exception from the operation into an error, on purpose. The `when` filter (a requested
# cancellation propagates) already keeps CA1031 quiet; this keeps the catch-all legal here and nowhere else.
[src/DotResult/Result.Try.cs]
dotnet_diagnostic.CA1031.severity = none
