<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DotResult.CompilerContractTests</RootNamespace>
  </PropertyGroup>

  <!--
    The contracts compile snippets with the very compiler this SDK builds with (sdk/<version>/Roslyn/bincore),
    so bumping global.json re-checks every contract against the new compiler.
    RoslynCoreAssembliesPath is set by the .NET SDK when it uses its own (Core) compiler, which is the default
    for `dotnet build` / `dotnet test`.
  -->
  <ItemGroup Condition="'$(RoslynCoreAssembliesPath)' != ''">
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$([MSBuild]::NormalizePath('$(RoslynCoreAssembliesPath)', 'Microsoft.CodeAnalysis.dll'))</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$([MSBuild]::NormalizePath('$(RoslynCoreAssembliesPath)', 'Microsoft.CodeAnalysis.CSharp.dll'))</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EnsureSdkCompilerIsReferenced" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <_SdkRoslynCSharpAssembly>$([MSBuild]::NormalizePath('$(RoslynCoreAssembliesPath)', 'Microsoft.CodeAnalysis.CSharp.dll'))</_SdkRoslynCSharpAssembly>
    </PropertyGroup>
    <Error Condition="'$(RoslynCoreAssembliesPath)' == '' or !Exists('$(_SdkRoslynCSharpAssembly)')"
           Text="The compiler contract tests need the .NET SDK's own Roslyn (RoslynCoreAssembliesPath='$(RoslynCoreAssembliesPath)'). Build with the dotnet CLI, or set RoslynCompilerType=Core." />
  </Target>

</Project>
